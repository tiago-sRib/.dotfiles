{
    "title": "Cmd+` → Option+Esc (app window switching)",
    "rules": [
        {
            "description": "Cmd+Shift+` → Option+Shift+Esc",
            "manipulators": [
                {
                    "type": "basic",
                    "from": {
                        "key_code": "grave_accent_and_tilde",
                        "modifiers": {
                            "mandatory": ["command", "shift"],
                            "optional": ["caps_lock"]
                        }
                    },
                    "to": [
                        {
                            "key_code": "escape",
                            "modifiers": ["option", "shift"]
                        }
                    ]
                }
            ]
        },
        {
            "description": "Cmd+` → Option+Esc",
            "manipulators": [
                {
                    "type": "basic",
                    "from": {
                        "key_code": "grave_accent_and_tilde",
                        "modifiers": {
                            "mandatory": ["command"],
                            "optional": ["caps_lock"]
                        }
                    },
                    "to": [
                        {
                            "key_code": "escape",
                            "modifiers": ["option"]
                        }
                    ]
                }
            ]
        }
    ]
}
